# exoguard — DLP gateway service image.
#
# Ships the `exo-gateway` binary built with the `dlp` feature mounted so the
# OpenAI/Anthropic/Gemini facades and the mcp_dlp / mcp_exoguard_ops tool
# domains are wired into the same HTTP + MCP surface the pilot already uses.
#
# The exochain node (n0) runs in a separate Railway service using the
# repo-root Dockerfile. The two services share a managed Postgres plugin.

FROM rust:1.88-slim-bookworm AS rust-builder
WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev clang && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
# Build the gateway + exoguard facade. The `dlp` feature on exo-gateway
# mounts the facade routes alongside the existing GraphQL and MCP surfaces.
RUN cargo build --release --bin exo-gateway

FROM debian:bookworm-slim
RUN apt-get update && \
    apt-get install -y ca-certificates libssl3 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY --from=rust-builder /app/target/release/exo-gateway /app/
COPY crates/exo-gateway/migrations /app/migrations
COPY infra/railway/entrypoint.exoguard.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

ENV EXOGUARD_DATA_DIR=/data
ENV RUST_LOG=info

# Facade HTTP + MCP transport.
EXPOSE 8443 8080

CMD ["/app/entrypoint.sh"]
