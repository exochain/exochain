{
  "manifest_version": 1,
  "integration": {
    "name": "example-tool",
    "revision": "0000000000000000000000000000000000000000",
    "owner": "Example Org",
    "accountable_maintainer": "Example Org platform team",
    "deployment_status": "prototype"
  },
  "core": {
    "release": "0.4.0"
  },
  "interfaces": [
    {
      "profile": "http",
      "contract": "PLACEHOLDER-dagdb-contract-id",
      "routes": [
        "POST /api/v1/dag-db/writeback"
      ],
      "host": "gateway"
    },
    {
      "profile": "verify",
      "package": "exochain-verify",
      "source": "registry",
      "version": "0.4.0"
    }
  ],
  "core_access": {
    "core_state": {
      "read": false,
      "write": true,
      "note": "dag-db writeback"
    },
    "signatures": {
      "read": false,
      "write": false
    },
    "credentials": {
      "read": false,
      "write": false
    },
    "governance_outcomes": {
      "read": false,
      "write": false
    },
    "consent_records": {
      "read": false,
      "write": false
    },
    "provenance_records": {
      "read": true,
      "write": false,
      "note": "receipts"
    }
  },
  "actions": [
    {
      "name": "save-note",
      "entry_point": "src/notes/save.ts: saveNote()",
      "core_decision": "POST /api/v1/dag-db/writeback",
      "gating": "gated",
      "effect": "The note is stored only if the writeback is accepted."
    }
  ],
  "trust_boundary": "The tool decides what the user asked to save. The core decides whether the write is allowed and records it.",
  "threat_model": "docs/threat-model.md",
  "deployment_boundary": "One service in the owner's cloud account; outbound calls only to the core gateway.",
  "credentials_model": "One route-scoped credential and one signing key, both issued to this integration as its own principal.",
  "trust_claims": {
    "allowed": false,
    "target_level": 2,
    "achieved_level": null,
    "result_file": null
  },
  "tests": {
    "command": "npm test",
    "ci_gate": "example-tool-tests"
  },
  "secrets": {
    "inventory": [
      "EXAMPLE_CORE_CREDENTIAL",
      "EXAMPLE_SIGNING_KEY"
    ],
    "source": "The deployment platform's secret store, read at start-up.",
    "holds": [
      {
        "description": "A route-scoped credential issued to this integration as its own principal",
        "issued_to_self": true
      },
      {
        "description": "A signing key issued to this integration as its own principal",
        "issued_to_self": true
      }
    ]
  },
  "disablement": "Set EXAMPLE_CORE_ENABLED=false and redeploy; the tool then refuses every save."
}
