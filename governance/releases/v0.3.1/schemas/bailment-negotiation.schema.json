          }
        },
        "required": [
          "parties"
        ]
      },
      "then": {
        "properties": {
          "threshold": {
            "maximum": 15
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parties": {
            "type": "array",
            "minItems": 16,
            "maxItems": 16
          }
        },
        "required": [
          "parties"
        ]
      },
      "then": {
        "properties": {
          "threshold": {
            "maximum": 16
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parties": {
            "type": "array",
            "minItems": 17
          }
        },
        "required": [
          "parties"
        ]
      },
      "then": {
        "properties": {
          "parties": {
            "maxItems": 16
          }
        }
      }
    }
  ]
}
