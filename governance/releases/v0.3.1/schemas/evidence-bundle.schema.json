{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exochain.io/schemas/proposal/v0.3.1/evidence-bundle.schema.json",
  "title": "EXOCHAIN v0.3.1 proposed portable evidence manifest",
  "description": "PROPOSAL. Not approved. Not returned by POST /api/v1/avc/validate. Not coverage.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "identity",
    "authority",
    "agreement",
    "payment",
    "execution",
    "outcome",
    "timestamp",
    "assurance"
  ],
  "properties": {
    "schema": { "const": "exo.market.evidence_bundle.v1" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principal_did", "agent_did", "credential_hash"],
      "properties": {
        "principal_did": { "type": "string", "pattern": "^did:exo:[A-Za-z0-9._:-]+$" },
        "agent_did": { "type": "string", "pattern": "^did:exo:[A-Za-z0-9._:-]+$" },
        "credential_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chain_hash", "pdp_evidence_hash", "decision"],
      "properties": {
        "chain_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "pdp_evidence_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "decision": { "enum": ["Allow", "Deny", "Challenge"] }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript_id", "terms_hash", "party_dids"],
      "properties": {
        "transcript_id": { "type": "string", "minLength": 1 },
        "terms_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "party_dids": {
          "type": "array",
          "minItems": 2,
          "items": { "type": "string", "pattern": "^did:exo:[A-Za-z0-9._:-]+$" }
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payment_evidence_hash", "reason"],
      "properties": {
        "payment_evidence_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "enum": ["bound", "not_commercial", "challenge_open", "denied"]
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fulfillment_hash", "reason"],
      "properties": {
        "fulfillment_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": { "enum": ["fulfilled", "not_executed"] }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discharge_hash", "reason"],
      "properties": {
        "discharge_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": { "enum": ["discharged", "open", "disputed"] }
      }
    },
    "timestamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_kind",
        "authority_did",
        "policy_oid",
        "message_imprint_sha256",
        "spki_pin_hex",
        "tsa_url"
      ],
      "properties": {
        "proof_kind": { "const": "Rfc3161" },
        "authority_did": { "type": "string", "minLength": 1 },
        "policy_oid": { "type": "string", "minLength": 1 },
        "message_imprint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "token_der_base64": { "type": "string" },
        "spki_pin_hex": { "type": "string", "pattern": "^[0-9a-f]+$" },
        "tsa_url": { "type": "string", "minLength": 1 }
      }
    },
    "assurance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverage_claim", "exochain_is_obligor", "statement"],
      "properties": {
        "coverage_claim": { "const": "none" },
        "exochain_is_obligor": { "const": false },
        "statement": {
          "const": "Interface only. EXOCHAIN does not provide insurance, surety, or bonding. No coverage is in force."
        }
      }
    }
  }
}
