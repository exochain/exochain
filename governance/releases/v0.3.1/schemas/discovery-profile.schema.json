{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://exochain.io/schemas/proposal/v0.3.1/discovery-profile.schema.json",
  "title": "EXOCHAIN v0.3.1 proposed A2A discovery card",
  "description": "PROPOSAL. Not approved. Discovery grants no authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "version",
    "grants_authority",
    "supported_interfaces",
    "skills",
    "exochain"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "grants_authority": { "const": false },
    "supported_interfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "protocol_binding", "protocol_version"],
        "properties": {
          "url": { "type": "string", "minLength": 1 },
          "protocol_binding": { "const": "HTTP+JSON" },
          "protocol_version": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "http_path"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "http_path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "exochain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_did", "signing_key_hex", "signature_hex", "schema"],
      "properties": {
        "service_did": { "type": "string", "pattern": "^did:exo:[A-Za-z0-9._:-]+$" },
        "signing_key_hex": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signature_hex": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
        "schema": { "const": "exo.market.discovery.card.v1" }
      }
    }
  }
}
