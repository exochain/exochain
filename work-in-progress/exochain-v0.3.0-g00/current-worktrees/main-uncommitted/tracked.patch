+/**
+ * Delta view across cross-check runs: where models agree vs collide.
+ * Pure derivation — no scoring, no truth claim.
+ * @param {Array<Record<string, any>>} runs
+ */
+export function crosscheckDelta(runs) {
+  const list = Array.isArray(runs) ? runs : [];
+  const verdicts = { support: 0, challenge: 0, abstain: 0, other: 0 };
+  /** @type {Array<{model: string, verdict: string}>} */
+  const models = [];
+  const contradictions = new Set();
+  const assumptions = new Set();
+
+  for (const run of list) {
+    const c = run?.content && typeof run.content === "object" ? run.content : {};
+    const v = String(c.verdict_hint || "other").toLowerCase();
+    if (v === "support" || v === "challenge" || v === "abstain") {
+      verdicts[v] += 1;
+    } else {
+      verdicts.other += 1;
+    }
+    models.push({ model: String(run.model || "unknown"), verdict: v });
+    for (const x of Array.isArray(c.contradictions) ? c.contradictions : []) {
+      contradictions.add(String(x));
+    }
+    for (const x of Array.isArray(c.unstated_assumptions)
+      ? c.unstated_assumptions
+      : []) {
+      assumptions.add(String(x));
+    }
+  }
+
+  const distinct = ["support", "challenge", "abstain"].filter(
+    (k) => verdicts[k] > 0,
+  ).length;
+  return {
+    models,
+    verdicts,
+    disagreement: distinct > 1,
+    contradictions: [...contradictions],
+    assumptions: [...assumptions],
+  };
+}
+
